<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jjcorner.app.controller.WelcomeController"
      spacing="18" alignment="CENTER" style="-fx-background-color: white;">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <VBox spacing="14" alignment="CENTER" maxWidth="620" styleClass="login-wrap">
        <ImageView fitWidth="200" fitHeight="200" preserveRatio="true" smooth="true">
            <image>
                <Image url="@jj-logo.png"/>
            </image>
        </ImageView>
        <Button text="Login" onAction="#onLogin" styleClass="welcome-link"/>
        <Button text="Sign-up" onAction="#onSignUp" styleClass="welcome-link"/>
    </VBox>
</VBox>

